{
  "name": "vesk-native",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "vesk-native — same .vsk syntax compiled to Kotlin + Compose Multiplatform (true native, no bridge)",
  "workspaces": [
    "packages/compiler-native",
    "packages/cli-native",
    "packages/create-native",
    "packages/native",
    "packages/navigation-native"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "spike": "tsx packages/compiler-native/src/spike.ts",
    "build:assets": "node scripts/sync-assets.mjs",
    "build:native": "npm run build -w @vesk/native",
    "build:compiler": "npm run build -w @vesk/native-compiler",
    "build:cli": "npm run build -w @vesk/native-cli",
    "build:create": "npm run build -w create-vesk-native",
    "build": "npm run build:assets && npm run build:native && npm run build:compiler && npm run build:cli && npm run build:create"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@vesk/compiler": "file:tarballs/vesk-compiler-0.1.11.tgz",
    "@vesk/runtime": "file:tarballs/vesk-runtime-0.1.9.tgz",
    "@vesk/adapter": "file:tarballs/vesk-adapter-0.1.9.tgz",
    "@vesk/plugin-tailwind": "file:tarballs/vesk-plugin-tailwind-0.1.4.tgz",
    "vesk": "file:tarballs/vesk-0.1.12.tgz"
  }
}
