{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@vesk/native": ["packages/native/src/index.ts"],
      "@compiler-native/*": ["packages/compiler-native/src/*.ts"],
      "@cli-native/*": ["packages/cli-native/src/*.ts"],
      "@navigation-native/*": ["packages/navigation-native/src/*.ts"],
      "@test-app/*": ["test-app/*"]
    }
  },
  "include": ["packages/**/*.ts", "test-app/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "packages/compiler-native/src/spike.ts",
    "packages/compiler-native/src/driver.ts",
    "packages/compiler-native/src/inspect-ast.ts",
    "packages/compiler-native/src/inspect-props.ts"
  ]
}
