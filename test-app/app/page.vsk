component Page() {
    const &[count] = track(0)
    const &[name] = track("Vesk")
    
    <h1 class="text-4xl font-bold mb-2">Hello {name}</h1>
    <p class="text-gray-500 mb-4">Counter: {count}</p>
    
    <div class="flex gap-2 mb-6">
        <button onClick={() => count--} class="px-4 py-2 bg-gray-200 rounded">-</button>
        <button onClick={() => count++} class="px-4 py-2 bg-blue-600 text-white rounded">+</button>
    </div>
    
    if (count > 5) {
        <p class="text-green-600 font-bold">Count is high!</p>
    } else {
        <p class="text-orange-600">Keep counting...</p>
    }
    
    <div class="border rounded-lg p-4">
        <h2 class="text-xl font-semibold mb-2">Features</h2>
        <ul class="list-disc pl-6">
            <li>Reactive state with track()</li>
            <li>Conditional rendering</li>
            <li>Event handlers</li>
        </ul>
    </div>
}
