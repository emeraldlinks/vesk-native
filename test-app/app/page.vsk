component Home() {
    const &[joined] = track(false)

    <style>
        .hero-summary { color: rgb(75, 85, 99); }
    </style>

    <div class="flex-col gap-6 px-4 py-4">

        <section class="bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-500 rounded-3xl p-7 min-h-40">
            <p class="text-white/90 text-xs font-semibold tracking-widest uppercase">Winter collection 2026 · Members save {Math.floor(Math.random() * 10 + 5)}% today</p>
            <h1 class="text-white mt-1 text-3xl font-extrabold leading-9">Layers for the long cold night</h1>
            <p class="hero-summary mt-2 text-sm leading-6 max-w-xs">
                Heattech knits, insulated shells and merino base layers. Engineered for warmth, tuned for style.
            </p>
            <div class="mt-6">
                <NavLink href="/shop">
                    <div class="bg-white text-indigo-700 px-5 py-2.5 rounded-full text-sm font-bold shadow-md self-start">Shop the drop</div>
                </NavLink>
            </div>
        </section>

        <section>
            <h2 class="text-sm font-bold tracking-wide uppercase text-gray-700 mb-3">Categories</h2>
            <div class="flex gap-2 flex-nowrap overflow-x-auto">
                <NavLink href="/shop">
                    <div class="bg-blue-600 text-white text-sm font-semibold px-4 py-2 rounded-full">All outerwear</div>
                </NavLink>
                <NavLink href="/shop">
                    <div class="bg-gray-100 text-gray-700 text-sm font-medium px-4 py-2 rounded-full">Knitwear</div>
                </NavLink>
                <NavLink href="/shop">
                    <div class="bg-gray-100 text-gray-700 text-sm font-medium px-4 py-2 rounded-full">Base layers</div>
                </NavLink>
                <NavLink href="/shop">
                    <div class="bg-gray-100 text-gray-700 text-sm font-medium px-4 py-2 rounded-full">Bags</div>
                </NavLink>
                <NavLink href="/shop">
                    <div class="bg-gray-100 text-gray-700 text-sm font-medium px-4 py-2 rounded-full">Accessories</div>
                </NavLink>
            </div>
        </section>

        <section>
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-lg font-bold tracking-tight">On home screens</h2>
                <p class="text-xs text-gray-500">bundled images</p>
            </div>
            <div class="flex gap-3 flex-nowrap overflow-x-auto">
                <img src="/media/lookbook.jpg" class="w-44 h-56 rounded-2xl object-cover" />
                <img src="/media/crew.jpg" class="w-44 h-56 rounded-2xl object-cover" />
                <img src="/media/coast.jpg" class="w-44 h-56 rounded-2xl object-cover" />
                <img src="/media/hills.jpg" class="w-44 h-56 rounded-2xl object-cover" />
                <img src="/media/beach-1.png" class="w-44 h-56 rounded-2xl object-cover" />
                <img src={"/media/beach-2.png"} class="w-44 h-56 rounded-2xl object-cover" />
                <img src="/media/water.jpg" class="w-44 h-56 rounded-2xl object-cover" />
                <img src="/media/sunset.jpg" class="w-44 h-56 rounded-2xl object-cover" />
                <img src="/media/beach-party.jpg" class="w-44 h-56 rounded-2xl object-cover" />
            </div>
        </section>

        <section>
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-lg font-bold tracking-tight">Motion &amp; sound</h2>
                <p class="text-xs text-gray-500">bundled + device files</p>
            </div>
            <div class="flex-col gap-4">
                <video src="/media/demo.mp4" controls class="rounded-2xl" />
                <video src="/media/demo.mp4" autoplay loop muted class="w-1/2 rounded-2xl" />
                <audio src="/media/last-train.mp3" controls class="bg-gray-100 rounded-full px-3 py-2" />
                <audio src="/storage/emulated/0/vesk_media/Last Train Home.mp3" controls class="bg-gray-100 rounded-full px-3 py-2" />
            </div>
        </section>

        <section>
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-lg font-bold tracking-tight">New arrivals</h2>
                <NavLink href="/shop" class="text-sm font-semibold text-blue-600">See all</NavLink>
            </div>
            <div class="flex flex-wrap -m-2">
                <NavLink href="/shop/arctic-hoodie">
                    <div class="bg-gray-100 rounded-2xl m-2 w-40">
                        <div class="aspect-square bg-gradient-to-br from-blue-400 to-indigo-600 rounded-2xl"></div>
                        <div class="px-3 py-2.5">
                            <p class="text-xs font-semibold text-blue-700 uppercase tracking-wide">New</p>
                            <p class="text-sm font-semibold leading-5 line-clamp-1">Arctic Fleece Hoodie</p>
                            <div class="flex items-center justify-between mt-1">
                                <p class="text-sm font-bold">$89</p>
                                <p class="text-xs text-gray-400 line-through">$120</p>
                            </div>
                        </div>
                    </div>
                </NavLink>
                <NavLink href="/shop/snow-parka">
                    <div class="bg-gray-100 rounded-2xl m-2 w-40">
                        <div class="aspect-square bg-gradient-to-br from-emerald-400 to-teal-600 rounded-2xl"></div>
                        <div class="px-3 py-2.5">
                            <p class="text-xs font-semibold text-emerald-700 uppercase tracking-wide">Best seller</p>
                            <p class="text-sm font-semibold leading-5 line-clamp-1">Snowdrift Parka</p>
                            <div class="flex items-center justify-between mt-1">
                                <p class="text-sm font-bold">$219</p>
                                <p class="text-xs text-gray-400 line-through">$260</p>
                            </div>
                        </div>
                    </div>
                </NavLink>
                <NavLink href="/shop/merino-crew">
                    <div class="bg-gray-100 rounded-2xl m-2 w-40">
                        <div class="aspect-square bg-gradient-to-br from-amber-400 to-orange-600 rounded-2xl"></div>
                        <div class="px-3 py-2.5">
                            <p class="text-xs font-semibold text-amber-700 uppercase tracking-wide">Limited</p>
                            <p class="text-sm font-semibold leading-5 line-clamp-1">Merino Crew</p>
                            <div class="flex items-center justify-between mt-1">
                                <p class="text-sm font-bold">$75</p>
                                <p class="text-xs text-gray-400 line-through">$95</p>
                            </div>
                        </div>
                    </div>
                </NavLink>
                <NavLink href="/shop/splitshirt-tee">
                    <div class="bg-gray-100 rounded-2xl m-2 w-40">
                        <div class="aspect-square bg-gradient-to-br from-rose-400 to-pink-600 rounded-2xl"></div>
                        <div class="px-3 py-2.5">
                            <p class="text-xs font-semibold text-rose-700 uppercase tracking-wide">New</p>
                            <p class="text-sm font-semibold leading-5 line-clamp-1">Split Shoulder Tee</p>
                            <div class="flex items-center justify-between mt-1">
                                <p class="text-sm font-bold">$42</p>
                                <p class="text-xs text-gray-400 line-through">$55</p>
                            </div>
                        </div>
                    </div>
                </NavLink>
            </div>
        </section>

        <section class="bg-gray-900 rounded-2xl p-6 -mt-2">
            <p class="text-white/70 text-xs font-semibold tracking-widest uppercase">Members only</p>
            <h3 class="text-white text-xl font-extrabold mt-1">Free express shipping over $150</h3>
            <p class="text-white/70 text-sm mt-1 leading-6">Plus early access to limited drops, repairs and priority support.</p>
            <button class="bg-white text-gray-900 font-semibold text-sm px-5 py-2.5 rounded-full mt-4" onClick={() => { console.log('Nordi+ membership toggled'); joined = !joined }}>
                {joined ? 'You’re a member ✓' : 'Join Nordi+'}
            </button>
        </section>
    </div>
}