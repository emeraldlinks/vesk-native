component SnowParka() {
    const &[qty] = track(1)
    const &[added] = track(false)

    <div class="flex-col gap-6 px-4 py-2">
        <div class="bg-gradient-to-br from-emerald-400 to-teal-600 rounded-2xl h-72 flex items-center justify-center">
            <p class="bg-white/20 text-white text-xs font-bold px-3 py-1.5 rounded-full">Winter parka · 850 fill</p>
        </div>
        <section class="flex-col gap-2">
            <p class="text-xs font-semibold text-emerald-700 tracking-wide uppercase">Outerwear / Parkas</p>
            <h1 class="text-2xl font-extrabold leading-7 tracking-tight">Snowdrift Parka</h1>
            <div class="flex items-center gap-2 text-sm">
                <span class="text-amber-500 tracking-wider font-medium">★★★★★</span>
                <span class="text-gray-500">4.8 (96 reviews)</span>
            </div>
            <div class="flex items-end gap-2 mt-1">
                <p class="text-2xl font-extrabold">$219</p>
                <p class="text-sm text-gray-400 line-through mb-1">$260</p>
                <p class="text-xs text-green-600 font-semibold mb-1.5">save 16%</p>
            </div>
            <p class="text-sm text-gray-600 leading-6 mt-2">
                Waterproof 2L shell with 850-fill power down. Taped seams, helmet-compatible hood, pit zips and a two-way front zipper.
            </p>
        </section>
        <section class="flex items-center gap-3">
            <div class="flex items-center gap-1 rounded-full border border-gray-200 bg-white p-1 shadow-sm">
                <button class="w-9 h-9 rounded-full bg-gray-100 text-lg font-bold text-gray-600" onClick={() => { if (qty > 1) qty-- }}>−</button>
                <span class="w-8 text-center text-sm font-bold">{qty}</span>
                <button class="w-9 h-9 rounded-full bg-gray-900 text-lg font-bold text-white" onClick={() => qty++}>+</button>
            </div>
            <button class="flex-1 bg-emerald-600 text-white font-bold text-sm rounded-full py-3.5 shadow-sm" onClick={() => added = !added}>
                {added ? 'Added to bag ✓' : 'Add to cart · $' + 219 * qty}
            </button>
        </section>
        <NavLink href="/cart">
            <div class="bg-gray-900 text-white text-center font-bold text-sm rounded-full py-3.5">Go to bag</div>
        </NavLink>
    </div>
}