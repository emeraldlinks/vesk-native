component ArcticHoodie() {
    const &[qty] = track(1)
    const &[added] = track(false)

    <div class="flex-col gap-6 px-4 py-2">
        <div class="bg-gradient-to-br from-blue-400 to-indigo-600 rounded-2xl h-72 flex items-center justify-center">
            <p class="bg-white/20 text-white text-xs font-bold px-3 py-1.5 rounded-full">Since 2019 · best seller</p>
        </div>

        <section class="flex-col gap-2">
            <p class="text-xs font-semibold text-blue-700 tracking-wide uppercase">Outerwear / Hoodies</p>
            <h1 class="text-2xl font-extrabold leading-7 tracking-tight">Arctic Fleece Hoodie</h1>
            <div class="flex items-center gap-2 text-sm">
                <span class="text-amber-500 tracking-wider font-medium">★★★★★</span>
                <span class="text-gray-500">4.7 (212 reviews)</span>
            </div>
            <div class="flex items-end gap-2 mt-1">
                <p class="text-2xl font-extrabold">$89</p>
                <p class="text-sm text-gray-400 line-through mb-1">$120</p>
                <p class="text-xs text-green-600 font-semibold mb-1.5">save 26%</p>
            </div>
        </section>

        <section>
            <h3 class="text-sm font-bold mb-2">Color — pine green</h3>
            <div class="flex gap-2">
                <div class="w-8 h-8 bg-emerald-700 rounded-full ring-2 ring-offset-2 ring-emerald-700"></div>
                <div class="w-8 h-8 bg-slate-800 rounded-full"></div>
                <div class="w-8 h-8 bg-rose-600 rounded-full"></div>
                <div class="w-8 h-8 bg-amber-500 rounded-full"></div>
            </div>
        </section>

        <section>
            <h3 class="text-sm font-bold mb-2">Size</h3>
            <div class="flex gap-2">
                <div class="bg-blue-600 text-white text-sm font-semibold w-10 h-10 rounded-lg flex items-center justify-center">S</div>
                <div class="bg-gray-100 text-gray-700 text-sm font-medium w-10 h-10 rounded-lg flex items-center justify-center">M</div>
                <div class="bg-gray-100 text-gray-700 text-sm font-medium w-10 h-10 rounded-lg flex items-center justify-center">L</div>
                <div class="bg-gray-100 text-gray-700 text-sm font-medium w-10 h-10 rounded-lg flex items-center justify-center">XL</div>
                <div class="bg-gray-100 text-gray-400 text-sm font-medium w-10 h-10 rounded-lg flex items-center justify-center">2XL<span class="text-xs">(low)</span></div>
            </div>
        </section>

        <section class="flex items-center gap-3">
            <div class="flex items-center bg-gray-100 rounded-full px-2">
                <button class="w-9 h-9 text-lg font-bold text-gray-500" onClick={() => { if (qty > 1) qty-- }}>−</button>
                <span class="w-6 text-center text-sm font-bold">{qty}</span>
                <button class="w-9 h-9 text-lg font-bold text-gray-500" onClick={() => qty++}>+</button>
            </div>
            <button class="flex-1 bg-blue-600 text-white font-bold text-sm rounded-full py-3" onClick={() => added = true}>
                {added ? 'Added to cart ✓' : 'Add to cart · $' + 89 * qty}
            </button>
        </section>

        <section class="border border-gray-200 rounded-2xl p-4 flex-col gap-3">
            <div class="flex gap-3">
                <div class="bg-green-100 rounded-lg w-9 h-9 flex items-center justify-center"><span class="text-green-700 font-bold text-sm">✓</span></div>
                <div>
                    <p class="text-sm font-semibold">Free shipping</p>
                    <p class="text-xs text-gray-500">Delivered free on orders over $150</p>
                </div>
            </div>
            <div class="flex gap-3">
                <div class="bg-green-100 rounded-lg w-9 h-9 flex items-center justify-center"><span class="text-green-700 font-bold text-sm">✓</span></div>
                <div>
                    <p class="text-sm font-semibold">30-day returns</p>
                    <p class="text-xs text-gray-500">Free returns within 30 days of delivery</p>
                </div>
            </div>
        </section>

        <section class="rounded-2xl p-4 border-2 border-dashed border-indigo-300">
            <p class="text-sm font-semibold text-indigo-700">Nordi+ member price</p>
            <p class="text-xs text-gray-500 mt-1">Members save an extra 10% on this item at checkout.</p>
        </section>

        <section>
            <h3 class="text-sm font-bold mb-3">You may also like</h3>
            <div class="flex gap-3 overflow-x-auto pb-2">
                <div class="bg-gray-100 rounded-2xl w-36 shrink-0">
                    <div class="aspect-square bg-gradient-to-br from-green-400 to-emerald-600 rounded-2xl"></div>
                    <div class="px-3 py-2">
                        <p class="text-xs font-semibold leading-4 line-clamp-1">Storm Shell</p>
                        <p class="text-xs font-bold mt-1">$189</p>
                    </div>
                </div>
                <div class="bg-gray-100 rounded-2xl w-36 shrink-0">
                    <div class="aspect-square bg-gradient-to-br from-purple-400 to-violet-600 rounded-2xl"></div>
                    <div class="px-3 py-2">
                        <p class="text-xs font-semibold leading-4 line-clamp-1">Down Puffer</p>
                        <p class="text-xs font-bold mt-1">$240</p>
                    </div>
                </div>
                <div class="bg-gray-100 rounded-2xl w-36 shrink-0">
                    <div class="aspect-square bg-gradient-to-br from-orange-400 to-amber-600 rounded-2xl"></div>
                    <div class="px-3 py-2">
                        <p class="text-xs font-semibold leading-4 line-clamp-1">Base Layer Set</p>
                        <p class="text-xs font-bold mt-1">$62</p>
                    </div>
                </div>
            </div>
        </section>
    </div>
}