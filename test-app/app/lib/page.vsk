import { CoilImage } from '@vesk/coil'
import { GlideImage } from '@vesk/compose'
import { LineChart, LineChartData, LinePlotData, Line, Point, PlotType } from '@vesk/ycharts'

component Lib() {
    const chart = LineChartData({
        linePlotData: LinePlotData({
            plotType: PlotType.Line,
            lines: [
                Line({
                    dataPoints: [
                        Point({ x: 0, y: 22 }),
                        Point({ x: 1, y: 34 }),
                        Point({ x: 2, y: 15 }),
                        Point({ x: 3, y: 28 }),
                        Point({ x: 4, y: 19 }),
                        Point({ x: 5, y: 41 }),
                    ],
                }),
            ],
        }),
    })
    <div class="flex-col gap-6 px-4 py-4">

        <section>
            <h1 class="text-2xl font-extrabold tracking-tight">Installed libraries</h1>
            <p class="text-gray-500 text-sm mt-1">
                coil + ycharts + compose (glide) — wired from libraries.json at build time
            </p>
        </section>

        <section>
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700">Coil · network images</h2>
                <p class="text-xs text-gray-400">io.coil-kt:coil-compose</p>
            </div>
            <div class="flex gap-3 flex-nowrap overflow-x-auto">
                <CoilImage src="https://picsum.photos/seed/vesk1/200/260" alt="random photo one" class="w-40 h-52 rounded-2xl" />
                <CoilImage src="https://picsum.photos/seed/vesk2/200/260" alt="random photo two" class="w-40 h-52 rounded-2xl" />
                <CoilImage src="https://picsum.photos/seed/vesk3/200/260" alt="random photo three" class="w-40 h-52 rounded-2xl" />
            </div>
        </section>

        <section>
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700">Glide · network images</h2>
                <p class="text-xs text-gray-400">com.github.bumptech.glide:compose</p>
            </div>
            <div class="flex gap-3 flex-nowrap overflow-x-auto">
                <GlideImage model="https://picsum.photos/seed/veskg1/200/260" contentDescription="random photo one" class="w-40 h-52 rounded-2xl" />
                <GlideImage model="https://picsum.photos/seed/veskg2/200/260" contentDescription="random photo two" class="w-40 h-52 rounded-2xl" />
                <GlideImage model="https://picsum.photos/seed/veskg3/200/260" contentDescription="random photo three" class="w-40 h-52 rounded-2xl" />
            </div>
        </section>


        <section>
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700">YCharts · line chart</h2>
                <p class="text-xs text-gray-400">co.yml:ycharts</p>
            </div>
            <div class="bg-white rounded-2xl p-4">
                <LineChart lineChartData={chart} class="h-56 w-full" />
            </div>
        </section>

        <section>
            <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-3">Install more</h2>
            <pre class="bg-gray-900 text-green-400 text-xs rounded-2xl p-4">vesk add com.github.bumptech.glide:compose@1.0.0-beta01
vesk add co.yml:ycharts@2.1.0
vesk update</pre>
        </section>
    </div>
}
