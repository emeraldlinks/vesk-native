import { CoilImage } from '@vesk/coil'
import { GlideImage } from '@vesk/compose'
import { Coil3Image } from '@vesk/coil3'
import { LineChart, LineChartData, LinePlotData, Line, Point, PlotType } from '@vesk/ycharts'
import { SnackbarHostState } from '@vesk/material'
import { Divider, Card } from '@vesk/material3'
import { Box, Spacer } from '@vesk/foundation-layout'
import { MutatorMutex, LazyListState } from '@vesk/foundation'
import { Gson, JsonParser } from '@vesk/gson'
import { OkHttpClient } from '@vesk/okhttp'
import { QRCodeWriter, BarcodeFormat } from '@vesk/zxing'
import { ComposeNavigator, DialogNavigator } from '@vesk/navigation'
import { FloatTweenSpec } from '@vesk/animation-core'
import { RippleAlpha } from '@vesk/material-ripple'
import { ImmutableCollectionAdapter } from '@vesk/immutable-collections'
import { ConstraintLayout } from '@vesk/constraintlayout-compose'
import { Moshi } from '@vesk/moshi'
import { AnimatedVisibility } from '@vesk/animation'
import { Instant, TimeZone } from '@vesk/datetime'
import { Shimmer } from '@vesk/shimmer'
import { Retrofit } from '@vesk/retrofit'
import { Timber, DebugTree } from '@vesk/timber'
import { ChartScrollState } from '@vesk/vico'
import { Icons, Home, Search, Favorite, Star, Settings, ShoppingCart, Face, ThumbUp, Email, Notifications } from '@vesk/material-icons'
import { Lucide } from '@vesk/icons-lucide'
import { Icon } from '@vesk/material3'

component Lib() {
    const chart = LineChartData({
        linePlotData: LinePlotData({
            plotType: PlotType.Line,
            lines: [
                Line({
                    dataPoints: [
                        Point({ x: 0, y: 22 }),
                        Point({ x: 1, y: 34 }),
                        Point({ x: 2, y: 15 }),
                        Point({ x: 3, y: 28 }),
                        Point({ x: 4, y: 19 }),
                        Point({ x: 5, y: 41 }),
                    ],
                }),
            ],
        }),
    })

    const snackbarHost = SnackbarHostState()
    const mutex = MutatorMutex()
    const listState = LazyListState({})

    const gson = Gson()
    const json = gson.toJson({ name: 'vesk', version: '0.1', year: 2026 })
    const parsed = JsonParser().parse(json)

    const client = OkHttpClient()

    const writer = QRCodeWriter()
    const qr = writer.encode('VESK', BarcodeFormat.QR_CODE, 21, 21).toString()

    const navigator = ComposeNavigator()
    const dialogNav = DialogNavigator()

    const tween = FloatTweenSpec({})
    const ripple = RippleAlpha({ draggedAlpha: 0.4, focusedAlpha: 0.3, hoveredAlpha: 0.2, pressedAlpha: 0.6 })
    const adapter = ImmutableCollectionAdapter({ impl: [] })

    const moshi = new Moshi.Builder().build()
    const strAdapter = moshi.adapter(String)
    const moshiParsed = strAdapter.fromJson('"hello from moshi"')

    const retrofit = new Retrofit.Builder().baseUrl('https://api.example.com/').build()

    const debug = DebugTree()
    Timber.plant(debug)
    Timber.d('vesk-native timber demo')
    const treeCount = Timber.treeCount

    const &[showAnim] = track(true)

    const inst = Instant.parse('2026-08-12T10:00:00Z')

    const vicoScroll = ChartScrollState()

    <div class="flex-col gap-6 px-4 py-4">

        <section>
            <h1 class="text-2xl font-extrabold tracking-tight">27 installed libraries</h1>
            <p class="text-gray-500 text-sm mt-1">
                coil, compose (glide), coil3, ycharts, material, material3, foundation, foundation-layout,
                constraintlayout-compose, animation, navigation, activity-compose, datetime, animation-core,
                animation-graphics, immutable-collections, material-ripple, shimmer, gson, moshi, okhttp,
                retrofit, zxing, timber, kotlinx-serialization, vico, material-icons
            </p>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-2">1. coil — async images</h2>
                <div class="flex gap-2">
                    <CoilImage src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=240&q=80" alt="coil 1" class="w-24 h-32 rounded-xl" />
                    <CoilImage src="https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=240&q=80" alt="coil 2" class="w-24 h-32 rounded-xl" />
                    <CoilImage src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=240&q=80" alt="coil 3" class="w-24 h-32 rounded-xl" />
                </div>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-2">2. compose (glide) — async images</h2>
                <div class="flex gap-2">
                    <GlideImage model="https://images.unsplash.com/photo-1501785888041-af3ef285b470?w=240&q=80" contentDescription="glide 1" class="w-24 h-32 rounded-xl" />
                    <GlideImage model="https://images.unsplash.com/photo-1519681393784-d120267933ba?w=240&q=80" contentDescription="glide 2" class="w-24 h-32 rounded-xl" />
                    <GlideImage model="https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=240&q=80" contentDescription="glide 3" class="w-24 h-32 rounded-xl" />
                </div>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-2">3. coil3 — async images</h2>
                <div class="flex gap-2">
                    <Coil3Image src="https://images.unsplash.com/photo-1449824913935-59a10b8d2000?w=240&q=80" alt="coil3 1" class="w-24 h-32 rounded-xl" />
                    <Coil3Image src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=240&q=80" alt="coil3 2" class="w-24 h-32 rounded-xl" />
                    <Coil3Image src="https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?w=240&q=80" alt="coil3 3" class="w-24 h-32 rounded-xl" />
                </div>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-2">4. ycharts — line chart</h2>
                <LineChart lineChartData={chart} class="h-56 w-full" />
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700">5. material (M2)</h2>
                <p class="text-gray-600 text-sm">SnackbarHostState constructed in script — ready for SnackbarHost.</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">6. material3 (M3)</h2>
                <Card class="w-full bg-gray-50 p-3">
                    <div class="flex-col gap-1">
                        <p class="text-sm font-bold">Card + Divider</p>
                        <p class="text-gray-600 text-xs">M3 card with a divider between its rows.</p>
                    </div>
                </Card>
                <Divider class="h-2" />
                <p class="text-gray-600 text-xs">Divider above.</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700">7. foundation-layout</h2>
                <Box class="w-16 h-16 bg-indigo-500 rounded-2xl" />
                <Spacer class="h-2" />
                <p class="text-gray-600 text-sm">Colored Box above, Spacer below.</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700">8. foundation</h2>
                <p class="text-gray-600 text-sm">LazyListState — firstVisibleItemIndex: {listState.firstVisibleItemIndex}</p>
                <p class="text-gray-600 text-sm">MutatorMutex constructed in script.</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">9. gson — JSON</h2>
                <p class="text-xs text-gray-500">serialized:</p>
                <pre class="bg-gray-900 text-green-400 text-xs rounded-xl p-3 whitespace-pre-wrap">{json}</pre>
                <p class="text-xs text-gray-500 mt-1">parsed back (JsonParser):</p>
                <pre class="bg-gray-900 text-green-400 text-xs rounded-xl p-3 whitespace-pre-wrap">{parsed.toString()}</pre>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">10. okhttp — HTTP client</h2>
                <p class="text-gray-600 text-sm">connectTimeout: {client.connectTimeoutMillis} ms</p>
                <p class="text-gray-600 text-sm">readTimeout: {client.readTimeoutMillis} ms</p>
                <p class="text-gray-600 text-sm">callTimeout: {client.callTimeoutMillis} ms</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-2">11. zxing — QR encode (21x21)</h2>
                <pre class="bg-gray-900 text-green-400 text-[10px] leading-4 rounded-xl p-3">{qr}</pre>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">12. navigation</h2>
                <p class="text-gray-600 text-sm">ComposeNavigator constructed — ready for a NavHost.</p>
                <p class="text-gray-600 text-sm">DialogNavigator constructed — ready for a DialogHost.</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">13. animation-core</h2>
                <p class="text-gray-600 text-sm">FloatTweenSpec — duration: {tween.duration} ms, delay: {tween.delay} ms</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">14. material-ripple</h2>
                <p class="text-gray-600 text-sm">pressed: {ripple.pressedAlpha} · focused: {ripple.focusedAlpha}</p>
                <p class="text-gray-600 text-sm">hovered: {ripple.hoveredAlpha} · dragged: {ripple.draggedAlpha}</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">15. immutable-collections</h2>
                <p class="text-gray-600 text-sm">ImmutableCollectionAdapter — {adapter.size} items: {adapter.joinToString()}</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">16. constraintlayout-compose</h2>
                <ConstraintLayout class="w-full bg-gray-100 rounded-xl p-3">
                    <div class="bg-blue-100 text-blue-800 text-xs font-semibold rounded-lg px-3 py-2">ConstraintLayout renders its children — the ConstraintLayoutScope DSL is internal to the composable, so markup children flow inside it.</div>
                </ConstraintLayout>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">17. moshi</h2>
                <p class="text-gray-600 text-sm">Moshi built via new Moshi.Builder().build(); adapter(String).fromJson() →</p>
                <pre class="bg-gray-900 text-green-400 text-xs rounded-xl p-3 whitespace-pre-wrap">{moshiParsed}</pre>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700">18. animation</h2>
                <button class="bg-blue-600 text-white text-sm font-semibold px-4 py-2 rounded-xl" onClick={() => { showAnim = !showAnim }}>
                    {showAnim ? 'Hide' : 'Show'} animated card
                </button>
                <AnimatedVisibility visible={showAnim} label="demo">
                    <div class="bg-blue-500 text-white font-bold rounded-xl px-6 py-4">fade + scale in / out</div>
                </AnimatedVisibility>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">19. activity-compose</h2>
                <p class="text-gray-600 text-sm">ManagedActivityResultLauncher — interface-only surface (remember launchers); imports fail closed by design.</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">20. datetime</h2>
                <p class="text-gray-600 text-sm">Instant: {inst.toString()}</p>
                <p class="text-gray-600 text-sm">Zone: {TimeZone.UTC.toString()}</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">21. animation-graphics</h2>
                <p class="text-gray-600 text-sm">AnimatedImageVector — public class, but its constructor and AnimatedVectorTarget are Kotlin-internal (verified); instances only come from animated-vector XML resources via loadAnimatedVectorResource, which needs Android Resources — not expressible in vesk JS. Imports fail closed by design.</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">22. shimmer</h2>
                <Shimmer class="w-full">
                    <div class="bg-gray-200 rounded-xl px-4 py-3 text-sm">Shimmer wraps children with Modifier.shimmer() — a live sweep animation.</div>
                </Shimmer>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">23. kotlinx-serialization</h2>
                <pre class="bg-gray-900 text-green-400 text-xs rounded-xl p-3 whitespace-pre-wrap">JsonObject's content map needs JsonElement values — JS object literals map to Map&lt;String, Any?&gt;, so construction fails closed by design.</pre>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">24. retrofit</h2>
                <p class="text-gray-600 text-sm">Retrofit built via new Retrofit.Builder().baseUrl(...).build() — base URL: {retrofit.baseUrl()}</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-1">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">25. timber</h2>
                <p class="text-gray-600 text-sm">Timber.DebugTree() planted, a demo message logged — {treeCount} tree(s) in the forest (see Logcat).</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-2">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">26. vico — chart scroll state</h2>
                <div class="bg-gray-100 rounded-xl px-4 py-3 flex-col gap-1">
                    <p class="text-sm font-bold">ChartScrollState from vico 1.14.0</p>
                    <p class="text-gray-600 text-xs">scroll state: {vicoScroll.toString()}</p>
                    <p class="text-gray-600 text-xs">ChartStyle/lineChart/columnChart bindings fail closed — their parameter types aren't JS-constructible.</p>
                </div>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">27. material-icons — 49 core icons</h2>
                <div class="flex gap-3 items-center">
                    <Icon imageVector={Icons.Filled.Home} contentDescription="home" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Icons.Filled.Search} contentDescription="search" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Icons.Filled.Favorite} contentDescription="favorite" class="w-8 h-8 text-red-500" />
                    <Icon imageVector={Icons.Filled.Star} contentDescription="star" class="w-8 h-8 text-amber-500" />
                    <Icon imageVector={Icons.Filled.Settings} contentDescription="settings" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Icons.Filled.ShoppingCart} contentDescription="cart" class="w-8 h-8 text-gray-700" />
                </div>
                <div class="flex gap-3 items-center">
                    <Icon imageVector={Icons.Filled.Face} contentDescription="face" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Icons.Filled.ThumbUp} contentDescription="thumbs up" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Icons.Filled.Email} contentDescription="email" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Icons.Filled.Notifications} contentDescription="notifications" class="w-8 h-8 text-gray-700" />
                </div>
                <p class="text-gray-600 text-xs">All 49 Icons.Default (filled) vectors from material-icons-core 1.6.8.</p>
            </div>
        </section>

        <section>
            <div class="bg-white rounded-2xl p-4 flex-col gap-3">
                <h2 class="text-sm font-bold uppercase tracking-wide text-gray-700 mb-1">28. icons-lucide — 1665 icons</h2>
                <div class="flex gap-3 items-center">
                    <Icon imageVector={Lucide.House} contentDescription="home" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Lucide.Search} contentDescription="search" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Lucide.Heart} contentDescription="heart" class="w-8 h-8 text-red-500" />
                    <Icon imageVector={Lucide.Star} contentDescription="star" class="w-8 h-8 text-amber-500" />
                    <Icon imageVector={Lucide.Settings} contentDescription="settings" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Lucide.ShoppingCart} contentDescription="cart" class="w-8 h-8 text-gray-700" />
                </div>
                <div class="flex gap-3 items-center">
                    <Icon imageVector={Lucide.Smile} contentDescription="smile" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Lucide.ThumbsUp} contentDescription="thumbs up" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Lucide.Mail} contentDescription="mail" class="w-8 h-8 text-gray-700" />
                    <Icon imageVector={Lucide.Bell} contentDescription="bell" class="w-8 h-8 text-gray-700" />
                </div>
                <p class="text-gray-600 text-xs">Lucide icons from com.composables:icons-lucide-cmp:2.2.1, read as extension properties on Lucide.</p>
            </div>
        </section>
    </div>
}
