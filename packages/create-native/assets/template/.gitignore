# Node dependencies
node_modules/

# Gradle / Kotlin build output (regenerated every build)
.gradle/
.kotlin/
build/

# Vesk framework state (regenerated by install/build)
.vesk/
.vsklib/

# Machine-specific Android SDK location. The vesk CLI regenerates
# local.properties when missing, or ANDROID_HOME/ANDROID_SDK_ROOT resolve the
# SDK at build time — never commit it.
local.properties

# Logs / editor junk
*.log
.DS_Store