component Home() {
    const device = rememberDeviceApi()
    const &[count] = track(0)

    <div class="flex-col items-center justify-center min-h-full bg-gray-100 px-6 gap-10">
        <div class="flex-col items-center gap-3">
            <p class="text-xs font-semibold tracking-widest uppercase text-gray-500">Counter</p>
            <p class="text-6xl font-extrabold text-gray-900">{count}</p>
        </div>

        <div class="flex gap-3">
            <button class="bg-indigo-600 text-white text-sm font-semibold px-6 py-3 rounded-2xl" onclick={() => count = count + 1}>
                + Increment
            </button>
            <button class="bg-gray-200 text-gray-700 text-sm font-semibold px-6 py-3 rounded-2xl" onclick={() => count = 0}>
                Reset
            </button>
        </div>

        <button class="bg-gray-900 text-white text-sm font-semibold px-6 py-3 rounded-2xl" onclick={() => device.notify('Counter App', 'You tapped the counter ' + count + ' times')}>
            Send test notification
        </button>
    </div>
}
