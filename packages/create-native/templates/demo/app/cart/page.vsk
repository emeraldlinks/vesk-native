component Cart() {
    const &[qty1] = track(1)
    const &[qty2] = track(2)
    const &[qty3] = track(1)
    const &[promo] = track(false)

    <div class="flex-col gap-6 px-4 py-2">
        <section>
            <h1 class="text-2xl font-extrabold tracking-tight">Your bag</h1>
            <p class="text-gray-600 text-sm mt-1">3 items</p>
        </section>

        <section class="flex-col gap-4">
            <div class="bg-gray-50 rounded-2xl p-4 flex gap-3 items-center">
                <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-blue-400 to-indigo-600"></div>
                <div class="flex-1">
                    <p class="text-sm font-semibold">Arctic Fleece Hoodie</p>
                    <p class="text-xs text-gray-400 mt-0.5">M · Pine green</p>
                    <div class="flex items-center justify-between mt-2">
                        <div class="flex items-center gap-1 rounded-full border border-gray-200 bg-white p-1 shadow-sm">
                            <button class="w-7 h-7 rounded-full bg-gray-100 text-sm font-bold text-gray-600" onClick={() => { if (qty1 > 1) qty1-- }}>−</button>
                            <span class="w-6 text-center text-xs font-bold">{qty1}</span>
                            <button class="w-7 h-7 rounded-full bg-gray-900 text-sm font-bold text-white" onClick={() => qty1++}>+</button>
                        </div>
                        <p class="text-sm font-bold">$89</p>
                    </div>
                </div>
            </div>

            <div class="bg-gray-50 rounded-2xl p-4 flex gap-3 items-center">
                <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-emerald-400 to-teal-600"></div>
                <div class="flex-1">
                    <p class="text-sm font-semibold">Snowdrift Parka</p>
                    <p class="text-xs text-gray-400 mt-0.5">L · Storm gray</p>
                    <div class="flex items-center justify-between mt-2">
                        <div class="flex items-center gap-1 rounded-full border border-gray-200 bg-white p-1 shadow-sm">
                            <button class="w-7 h-7 rounded-full bg-gray-100 text-sm font-bold text-gray-600" onClick={() => { if (qty2 > 1) qty2-- }}>−</button>
                            <span class="w-6 text-center text-xs font-bold">{qty2}</span>
                            <button class="w-7 h-7 rounded-full bg-gray-900 text-sm font-bold text-white" onClick={() => qty2++}>+</button>
                        </div>
                        <p class="text-sm font-bold">$219</p>
                    </div>
                </div>
            </div>

            <div class="bg-gray-50 rounded-2xl p-4 flex gap-3 items-center">
                <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-amber-400 to-orange-600"></div>
                <div class="flex-1">
                    <p class="text-sm font-semibold">Merino Crew</p>
                    <p class="text-xs text-gray-400 mt-0.5">S · Oat</p>
                    <div class="flex items-center justify-between mt-2">
                        <div class="flex items-center gap-1 rounded-full border border-gray-200 bg-white p-1 shadow-sm">
                            <button class="w-7 h-7 rounded-full bg-gray-100 text-sm font-bold text-gray-600" onClick={() => { if (qty3 > 1) qty3-- }}>−</button>
                            <span class="w-6 text-center text-xs font-bold">{qty3}</span>
                            <button class="w-7 h-7 rounded-full bg-gray-900 text-sm font-bold text-white" onClick={() => qty3++}>+</button>
                        </div>
                        <p class="text-sm font-bold">$75</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="border border-gray-200 rounded-2xl p-4 flex-col gap-1">
            <div class="flex items-center justify-between text-sm">
                <p class="text-gray-500">Subtotal</p>
                <p class="font-semibold">${89 * qty1 + 219 * qty2 + 75 * qty3}</p>
            </div>
            <div class="flex items-center justify-between text-sm">
                <p class="text-gray-500">Shipping</p>
                <p class="font-semibold text-green-600">Free</p>
            </div>
            {promo &&
            <div class="flex items-center justify-between text-sm">
                <p class="text-gray-500">Promo — CODE10</p>
                <p class="font-semibold text-green-600">{`−$${Math.round((89 * qty1 + 219 * qty2 + 75 * qty3) * 0.1)}`}</p>
            </div>
            }
            <button class="self-start text-xs font-semibold text-blue-600 mt-1" onClick={() => promo = !promo}>
                {promo ? 'Remove promo code' : 'Apply promo code'}
            </button>
            <div class="flex items-center justify-between mt-2 pt-3 border-t border-gray-100">
                <p class="font-bold">Total</p>
                <p class="font-extrabold text-lg">{`$${Math.round((89 * qty1 + 219 * qty2 + 75 * qty3) * (promo ? 0.9 : 1))}`}</p>
            </div>
        </section>

        <NavLink href="/checkout">
            <div class="bg-blue-600 text-white text-center font-bold text-sm rounded-full py-3.5 shadow-sm">{`Checkout — $${Math.round((89 * qty1 + 219 * qty2 + 75 * qty3) * (promo ? 0.9 : 1))}`}</div>
        </NavLink>
    </div>
}