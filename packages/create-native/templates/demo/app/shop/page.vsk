component Shop() {
    const &[filter] = track('All')

    <div class="flex-col gap-6 px-4 py-2">
        <section>
            <h1 class="text-2xl font-extrabold tracking-tight">Outerwear &amp; layers</h1>
            <p class="text-gray-600 text-sm mt-1">{filter === 'All' ? '6 products, sorted by "recommended"' : filter === 'Parkas' ? '1 product — Parkas' : filter === 'Hoodies' ? '1 product — Hoodies' : filter === 'Shells' ? '1 product — Shells' : filter === 'Base layers' ? '2 products — Base layers' : '2 products — Accessories'}</p>
            <div class="flex gap-2 mt-3 flex-nowrap overflow-x-auto">
                <button onClick={() => filter = 'All'}>
                    {filter === 'All' ? <span class="bg-blue-600 text-white text-xs font-semibold rounded-full px-3 py-1.5">All</span> : <span class="bg-gray-100 text-gray-700 text-xs font-medium rounded-full px-3 py-1.5">All</span>}
                </button>
                <button onClick={() => filter = 'Parkas'}>
                    {filter === 'Parkas' ? <span class="bg-blue-600 text-white text-xs font-semibold rounded-full px-3 py-1.5">Parkas</span> : <span class="bg-gray-100 text-gray-700 text-xs font-medium rounded-full px-3 py-1.5">Parkas</span>}
                </button>
                <button onClick={() => filter = 'Hoodies'}>
                    {filter === 'Hoodies' ? <span class="bg-blue-600 text-white text-xs font-semibold rounded-full px-3 py-1.5">Hoodies</span> : <span class="bg-gray-100 text-gray-700 text-xs font-medium rounded-full px-3 py-1.5">Hoodies</span>}
                </button>
                <button onClick={() => filter = 'Shells'}>
                    {filter === 'Shells' ? <span class="bg-blue-600 text-white text-xs font-semibold rounded-full px-3 py-1.5">Shells</span> : <span class="bg-gray-100 text-gray-700 text-xs font-medium rounded-full px-3 py-1.5">Shells</span>}
                </button>
                <button onClick={() => filter = 'Base layers'}>
                    {filter === 'Base layers' ? <span class="bg-blue-600 text-white text-xs font-semibold rounded-full px-3 py-1.5">Base layers</span> : <span class="bg-gray-100 text-gray-700 text-xs font-medium rounded-full px-3 py-1.5">Base layers</span>}
                </button>
                <button onClick={() => filter = 'Accessories'}>
                    {filter === 'Accessories' ? <span class="bg-blue-600 text-white text-xs font-semibold rounded-full px-3 py-1.5">Accessories</span> : <span class="bg-gray-100 text-gray-700 text-xs font-medium rounded-full px-3 py-1.5">Accessories</span>}
                </button>
            </div>
        </section>

        <section class="flex flex-wrap gap-3">
            {filter === 'Hoodies' &&
            <>
                <NavLink href="/shop/arctic-hoodie">
                    <div class="bg-gray-100 rounded-2xl w-44">
                        <div class="aspect-square bg-gradient-to-br from-blue-400 to-indigo-600 rounded-2xl flex items-center justify-center">
                            <span class="text-white text-xs font-bold px-2 py-1 bg-black/40 rounded-full">-26%</span>
                        </div>
                        <div class="px-3 py-2.5">
                            <p class="text-sm font-semibold leading-5 line-clamp-1">Arctic Fleece Hoodie</p>
                            <p class="text-xs text-gray-400 mt-0.5">4.5 ★ (212)</p>
                            <div class="flex items-center justify-between mt-1">
                                <p class="text-sm font-bold">$89</p>
                                <p class="text-xs text-gray-400 line-through">$120</p>
                            </div>
                        </div>
                    </div>
                </NavLink>
            </>}
            {filter === 'Parkas' &&
            <>
                <NavLink href="/shop/snow-parka">
