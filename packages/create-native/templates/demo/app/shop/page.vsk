                    <div class="px-3 py-2.5">
                        <p class="text-sm font-semibold leading-5 line-clamp-1">Alpine Hardshell</p>
                        <p class="text-xs text-gray-400 mt-0.5">Ships in 2 weeks</p>
                        <p class="text-sm font-bold mt-1">$189</p>
