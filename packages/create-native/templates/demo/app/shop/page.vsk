                <NavLink href="/shop/merino-crew">
                    <div class="bg-gray-100 rounded-2xl w-44">
                        <div class="aspect-square bg-gradient-to-br from-amber-400 to-orange-600 rounded-2xl flex items-center justify-center">
                            <span class="text-white text-xs font-bold px-2 py-1 bg-black/20 rounded-full">New</span>
                        </div>
                        <div class="px-3 py-2.5">
