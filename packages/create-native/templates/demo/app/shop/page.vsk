                    <div class="aspect-square bg-gradient-to-br from-violet-400 to-purple-600 rounded-2xl flex items-center justify-center">
                        <span class="text-white text-xs font-bold px-2 py-1 bg-black/20 rounded-full">-20%</span>
                    </div>
                    <div class="px-3 py-2.5">
                        <p class="text-sm font-semibold leading-5 line-clamp-1">Weekend Tote</p>
                        <p class="text-xs text-gray-400 mt-0.5">4.5 ★ (41)</p>
                        <div class="flex items-center justify-between mt-1">
                            <p class="text-sm font-bold">$64</p>
                            <p class="text-xs text-gray-400 line-through">$80</p>
                        </div>
