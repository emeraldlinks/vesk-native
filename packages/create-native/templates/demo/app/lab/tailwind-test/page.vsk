component TailwindTest() {
    <style>
        .tw-card {
            background: rgb(250, 250, 250);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 8px;
        }
        .tw-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: rgb(99, 102, 241);
            margin-bottom: 4px;
        }
        .tw-big {
            max-width: 200px;
            max-height: 60px;
            min-width: 80px;
            min-height: 30px;
            background: rgb(191, 219, 254);
            border-radius: 8px;
        }
        .tw-overflower {
            width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: rgb(107, 114, 128);
        }
        .tw-vis {
            visibility: hidden;
            font-size: 12px;
        }
        .tw-z {
            z-index: 50;
            background: rgb(239, 68, 68);
            color: white;
            border-radius: 4px;
            padding: 4px;
            font-size: 10px;
        }
        .tw-basis-a {
            flex-basis: 33%;
            background: rgb(196, 181, 253);
            border-radius: 8px;
            padding: 8px;
            font-size: 12px;
        }
        .tw-basis-b {
            flex-basis: 66%;
            background: rgb(167, 243, 208);
            border-radius: 8px;
            padding: 8px;
            font-size: 12px;
        }
        .tw-border-top {
            border-top: 2px solid rgb(99, 102, 241);
            padding-top: 8px;
        }
        .tw-border-side {
            border-left: 3px solid rgb(236, 72, 153);
            padding-left: 8px;
        }
        .tw-shrink0 {
            background: rgb(254, 240, 138);
            border-radius: 4px;
            padding: 4px;
            font-size: 12px;
            flex-shrink: 0;
        }
    </style>

    <div class="flex-col gap-2 px-4 py-4">

        <p class="text-lg font-bold">Tailwind Utility Test</p>

        <div class="tw-card">
            <p class="tw-label">Flex Basis</p>
            <div class="flex gap-2">
                <div class="tw-basis-a">basis 33%</div>
                <div class="tw-basis-b">basis 66%</div>
            </div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Flex 0 / None / Shrink-0</p>
            <div class="flex gap-2">
                <div class="bg-blue-100 rounded px-2 py-1 text-xs">default</div>
                <div class="bg-blue-200 rounded px-2 py-1 text-xs flex-1">flex-1 grows</div>
                <div class="tw-shrink0">shrink-0</div>
            </div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Viewport Units</p>
            <div class="bg-emerald-100 rounded px-3 py-2 text-xs w-svw">w-svw = full width</div>
            <div class="bg-emerald-200 rounded px-3 py-2 text-xs h-8">h-8 fixed</div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Size Viewport Keyword</p>
            <div class="bg-amber-100 rounded px-3 py-2 text-xs size-svw">size-svw</div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Min/Max Width and Height</p>
            <div class="tw-big flex items-center justify-center bg-blue-100 text-xs">
                min-w:80 max-w:200 min-h:30 max-h:60
            </div>
        </div>

        <div class="tw-card relative">
            <p class="tw-label">Z-Index</p>
            <div class="relative">
                <div class="tw-z">z-50 on top</div>
                <div class="bg-gray-200 rounded px-2 py-1 text-xs mt-1">behind</div>
            </div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Overflow / Text-Overflow / White-Space</p>
            <div class="tw-overflower">This is a very long text that should be truncated with ellipsis because it exceeds the available width and white-space is nowrap</div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Letter Spacing</p>
            <p class="text-xs" style="letter-spacing: 0.1em;">spaced out letters</p>
            <p class="text-xs" style="letter-spacing: -0.05em;">tight letters</p>
        </div>

        <div class="tw-card">
            <p class="tw-label">Text Transform from CSS</p>
            <p class="text-xs" style="text-transform: uppercase;">uppercase via css</p>
            <p class="text-xs" style="text-transform: lowercase;">LOWCASE VIA CSS</p>
            <p class="text-xs" style="text-transform: capitalize;">capitalize via css</p>
        </div>

        <div class="tw-card">
            <p class="tw-label">Visibility Hidden</p>
            <p class="text-xs">visible above</p>
            <p class="tw-vis">this is hidden</p>
            <p class="text-xs">visible below</p>
        </div>

        <div class="tw-card">
            <p class="tw-label">Border Per-Side from CSS</p>
            <div class="tw-border-top text-xs">border-top: 2px indigo</div>
            <div class="tw-border-side text-xs mt-2">border-left: 3px pink</div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Grid grid-cols-3</p>
            <div class="grid grid-cols-3 gap-2">
                <div class="bg-violet-200 rounded p-2 text-xs">A</div>
                <div class="bg-violet-200 rounded p-2 text-xs">B</div>
                <div class="bg-violet-200 rounded p-2 text-xs">C</div>
                <div class="bg-violet-300 rounded p-2 text-xs">D</div>
                <div class="bg-violet-300 rounded p-2 text-xs">E</div>
                <div class="bg-violet-300 rounded p-2 text-xs">F</div>
            </div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Not-Italic</p>
            <p class="text-xs italic">italic text</p>
            <p class="text-xs italic not-italic">italic + not-italic = normal</p>
        </div>

        <div class="tw-card">
            <p class="tw-label">Border Radius from CSS</p>
            <div style="border-radius: 20px; background: rgb(196, 181, 253); padding: 8px; font-size: 12px; margin-bottom: 4px;">border-radius: 20px</div>
            <div style="border-radius: 4px; background: rgb(167, 243, 208); padding: 8px; font-size: 12px;">border-radius: 4px</div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Box Shadow from CSS</p>
            <div style="box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); border-radius: 8px; padding: 8px; font-size: 12px;">shadow from CSS</div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Opacity from CSS</p>
            <div style="opacity: 0.3; background: rgb(253, 224, 71); border-radius: 8px; padding: 8px; font-size: 12px;">opacity: 0.3</div>
            <div style="opacity: 1; background: rgb(253, 224, 71); border-radius: 8px; padding: 8px; font-size: 12px; margin-top: 4px;">opacity: 1</div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Margin from CSS</p>
            <div style="margin: 16px; background: rgb(191, 219, 254); border-radius: 8px; padding: 8px; font-size: 12px;">margin: 16px</div>
        </div>

        <div class="tw-card">
            <p class="tw-label">Width/Height from CSS</p>
            <div style="width: 150px; height: 40px; background: rgb(254, 202, 202); border-radius: 8px; padding: 8px; font-size: 12px;">150x40</div>
            <div style="width: 100%; height: 30px; background: rgb(187, 247, 208); border-radius: 8px; padding: 8px; font-size: 12px; margin-top: 4px;">100% width x 30px</div>
        </div>

        <p class="text-xs text-center text-gray-400 mt-4">all utilities compiled at build time</p>
    </div>
}
