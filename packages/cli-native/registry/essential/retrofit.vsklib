{
  "version": 1,
  "library": {
    "id": "retrofit",
    "name": "Retrofit",
    "description": "Type-safe typed HTTP client for Android/JVM",
    "group": "com.squareup.retrofit2",
    "artifact": "retrofit",
    "version": "2.11.0",
    "gradle": [
      "com.squareup.retrofit2:retrofit:2.11.0"
    ],
    "permissions": [
      "android.permission.INTERNET"
    ],
    "exports": [
      "Retrofit",
      "Builder"
    ],
    "tags": {},
    "signatures": {
      "Retrofit": {
        "name": "Retrofit",
        "target": "Retrofit",
        "qualified": "retrofit2.Retrofit",
        "jsdoc": "Retrofit REST client. Retrofit.Builder().baseUrl(url).build() constructs the client; Retrofit.baseUrl() / callAdapterFactories() read it back.",
        "isConstructor": false,
        "params": [],
        "defaultParams": [],
        "returnShape": "other"
      },
      "Builder": {
        "name": "Builder",
        "target": "Retrofit.Builder",
        "qualified": "retrofit2.Retrofit.Builder",
        "jsdoc": "Retrofit.Builder() — builder (public ctor); baseUrl(String), build().",
        "isConstructor": true,
        "params": [],
        "defaultParams": [],
        "returnShape": "other"
      }
    },
    "essential": true,
    "curated": true,
    "libType": "utility",
    "multiplatform": false
  }
}
