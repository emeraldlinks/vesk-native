{
  "version": 1,
  "library": {
    "id": "glide-compose",
    "name": "Glide Compose",
    "description": "Glide image loading for Compose",
    "group": "com.github.bumptech.glide",
    "artifact": "compose",
    "version": "1.0.0-beta01",
    "gradle": ["com.github.bumptech.glide:compose:1.0.0-beta01"],
    "permissions": ["android.permission.INTERNET"],
    "exports": ["GlideImage"],
    "tags": {
      "GlideImage": {
        "composable": "GlideImage",
        "imports": ["com.bumptech.glide.integration.compose.GlideImage"],
        "attrs": { "src": "model", "alt": "contentDescription" },
        "optIn": ["com.bumptech.glide.integration.compose.ExperimentalGlideComposeApi"]
      }
    },
    "curated": true
  }
}
