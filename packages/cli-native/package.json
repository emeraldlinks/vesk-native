{
  "name": "@vesk/native-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "vesk-native CLI — init/build/run a .vsk app as a native Kotlin + Compose app",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "vesk-native": "./dist/index.js"
  },
  "files": [
    "dist",
    "registry",
    "assets"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --tsconfig=../../tsconfig.json --banner:js='#!/usr/bin/env node'"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
