{
  "name": "aero-app",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "aero-app",
      "dependencies": {
        "@vesk/native": "file:/root/vesk-native/packages/native",
        "@vesk/native-cli": "file:/root/vesk-native/packages/cli-native",
        "@vesk/native-compiler": "file:/root/vesk-native/packages/compiler-native"
      },
      "devDependencies": {}
    },
    "../packages/cli-native": {
      "name": "@vesk/native-cli",
      "version": "0.1.0",
      "bin": {
        "vesk-native": "dist/index.js"
      },
      "devDependencies": {
        "typescript": "^5.8.0"
      }
    },
    "../packages/compiler-native": {
      "name": "@vesk/native-compiler",
      "version": "0.1.0",
      "devDependencies": {
        "typescript": "^5.8.0"
      }
    },
    "../packages/native": {
      "name": "@vesk/native",
      "version": "0.1.0"
    },
    "node_modules/@vesk/native": {
      "resolved": "../packages/native",
      "link": true
    },
    "node_modules/@vesk/native-cli": {
      "resolved": "../packages/cli-native",
      "link": true
    },
    "node_modules/@vesk/native-compiler": {
      "resolved": "../packages/compiler-native",
      "link": true
    }
  }
}
