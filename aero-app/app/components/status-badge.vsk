// StatusBadge — small status pill; the tone comes from a static class per
// status so styling stays fully declarative.

component StatusBadge(props: { status: string }) {
    {props.status === 'En route' ? <span class="flex-row items-center gap-1.5 rounded-full px-2.5 py-1 bg-cyan-500/15"><span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span><span class="text-[11px] font-medium text-cyan-300">{props.status}</span></span> : props.status === 'Boarding' ? <span class="flex-row items-center gap-1.5 rounded-full px-2.5 py-1 bg-amber-500/15"><span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span><span class="text-[11px] font-medium text-amber-300">{props.status}</span></span> : props.status === 'Landed' ? <span class="flex-row items-center gap-1.5 rounded-full px-2.5 py-1 bg-emerald-500/15"><span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span><span class="text-[11px] font-medium text-emerald-300">{props.status}</span></span> : props.status === 'Delayed' ? <span class="flex-row items-center gap-1.5 rounded-full px-2.5 py-1 bg-rose-500/15"><span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span><span class="text-[11px] font-medium text-rose-300">{props.status}</span></span> : <span class="flex-row items-center gap-1.5 rounded-full px-2.5 py-1 bg-[#1B2432]"><span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span><span class="text-[11px] font-medium text-slate-300">{props.status}</span></span>}
}